{
  "name": "anti-agent-feasibility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "playwright test",
    "capture": "node scripts/capture.mjs",
    "capture:control": "node scripts/control-experiment.mjs",
    "capture:native-control": "node scripts/native-control.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "benchmark:automation": "node scripts/benchmark-automation.mjs",
    "benchmark:randomized": "node scripts/benchmark-randomized.mjs",
    "benchmark:stack": "node scripts/benchmark-stack.mjs",
    "benchmark:decoys": "node scripts/benchmark-decoys.mjs",
    "benchmark:shadow": "node scripts/benchmark-shadow.mjs",
    "benchmark:worker": "node scripts/benchmark-worker.mjs",
    "benchmark:hardening": "node scripts/benchmark-hardening.mjs",
    "benchmark:tamper": "node scripts/benchmark-tamper.mjs",
    "benchmark:integrity": "node scripts/generate-integrity-lab.mjs && node scripts/benchmark-integrity.mjs",
    "benchmark:capture-signals": "node scripts/benchmark-capture-signals.mjs",
    "benchmark:hidden-capture": "node scripts/benchmark-hidden-capture.mjs",
    "benchmark:capture-timing": "node scripts/benchmark-capture-timing.mjs",
    "benchmark:cover": "node scripts/benchmark-cover.mjs",
    "benchmark:webgpu": "node scripts/benchmark-webgpu-capture.mjs",
    "verify:agent-proof": "node scripts/benchmark-combined-defense.mjs --require-blocking",
    "benchmark:runtime-cost": "node scripts/benchmark-runtime-cost.mjs",
    "benchmark:bare-cdp": "node scripts/benchmark-bare-cdp.mjs",
    "benchmark:isolated-frame": "node scripts/generate-isolated-frame.mjs && node scripts/benchmark-bare-cdp.mjs --isolated",
    "benchmark:desynchronized-canvas": "node scripts/benchmark-desynchronized-canvas.mjs",
    "benchmark:combined-guards": "node scripts/benchmark-bare-cdp.mjs --all-guards",
    "verify:combined-guards": "node scripts/benchmark-bare-cdp.mjs --all-guards --require-blocking",
    "benchmark:persistent-device": "node scripts/benchmark-persistent-device.mjs",
    "benchmark:native-select": "node scripts/benchmark-native-select.mjs",
    "verify:native-select": "node scripts/benchmark-native-select.mjs --require-blocking",
    "benchmark:bot-signal": "node scripts/benchmark-bot-signal.mjs",
    "benchmark:drm-fullscreen": "node scripts/benchmark-drm-fullscreen.mjs",
    "verify:drm-fullscreen": "node scripts/benchmark-drm-fullscreen.mjs --require-blocking",
    "benchmark:layered-guards": "MODES=bare node scripts/benchmark-bare-cdp.mjs --layered",
    "verify:layered-guards": "MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --require-blocking",
    "benchmark:drm-pip-screencast": "DRM_PIP_SCREENCAST=1 node scripts/benchmark-drm-pip.mjs",
    "benchmark:protected-output": "node scripts/benchmark-protected-output.mjs",
    "verify:protected-output": "node scripts/benchmark-protected-output.mjs --require-blocking",
    "benchmark:password-mask": "node scripts/benchmark-password-mask.mjs",
    "benchmark:agent-routes": "MODES=bare,runtime-enabled,runtime-zero,runtime-disabled node scripts/benchmark-bare-cdp.mjs --layered --audit",
    "benchmark:agent-playwright": "node scripts/benchmark-agent-route-playwright.mjs",
    "benchmark:layout-freshness": "MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness",
    "benchmark:layout-hold": "MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --hold-capture",
    "benchmark:layout-fast": "CAPTURE_FRAMES=4 MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --fast-capture",
    "benchmark:layout-bounded-hold": "CAPTURE_FRAMES=32 MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --hold-capture --fast-capture",
    "benchmark:decoy-color": "CAPTURE_FRAMES=4 MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --fast-capture --decoy-mask",
    "benchmark:decoy-virtual": "RESULT_PATH=docs/decoy-virtual-final-results.json CAPTURE_FRAMES=16 MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --fast-capture --decoy-mask --stable-columns --virtual-clock",
    "benchmark:clock-guard-virtual": "RESULT_PATH=docs/clock-guard-virtual-results.json CAPTURE_FRAMES=16 MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --fast-capture --decoy-mask --stable-columns --virtual-clock --clock-guard",
    "benchmark:clock-guard-lean": "RESULT_PATH=docs/clock-guard-lean-results.json CAPTURE_FRAMES=8 MODES=bare node scripts/benchmark-bare-cdp.mjs --layered --freshness --fast-capture --decoy-mask --stable-columns --clock-guard --lean-capture",
    "benchmark:document-pip": "node scripts/benchmark-document-pip.mjs"
  },
  "dependencies": {
    "shaka-player": "5.2.13"
  },
  "devDependencies": {
    "@fingerprintjs/botd": "2.0.0",
    "@playwright/test": "1.64.0",
    "bot-signal": "2.0.18",
    "pngjs": "7.0.0",
    "vite": "8.3.4"
  }
}
